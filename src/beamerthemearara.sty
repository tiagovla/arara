\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{beamerthemearara}[2026/11/06 Arara Beamer theme]

\RequirePackage{tikz}
\mode<presentation>

\newif\ifarara@dark
\def\arara@progressbar{frametitle}
\def\arara@none{none}
\def\arara@frametitle{frametitle}
\def\arara@foot{foot}
\def\arara@sectionpage{simple}
\DeclareOptionBeamer{dark}{\arara@darktrue}
\DeclareOptionBeamer{progressbar}[frametitle]{\def\arara@progressbar{#1}}
\DeclareOptionBeamer{sectionpage}[simple]{\def\arara@sectionpage{#1}}
\ProcessOptionsBeamer

\ifarara@dark
\definecolor{araraPrimary}{HTML}{183B56}
\definecolor{araraInk}{HTML}{E2EAF0}
\definecolor{araraGold}{HTML}{D7B96F}
\definecolor{araraBlue}{HTML}{79B6C5}
\definecolor{araraPaper}{HTML}{E2EAF0}
\definecolor{araraCanvas}{HTML}{0D1924}
\definecolor{araraMist}{HTML}{314657}
\definecolor{araraPanel}{HTML}{162735}
\definecolor{araraPanelSoft}{HTML}{13222F}
\setbeamercolor{normal text}{fg=araraInk,bg=araraCanvas}
\setbeamercolor{structure}{fg=araraBlue}
\setbeamercolor{alerted text}{fg=araraGold}
\setbeamercolor{example text}{fg=araraBlue}
\setbeamercolor{block title}{fg=araraInk,bg=araraPrimary!75}
\setbeamercolor{block body}{fg=araraInk,bg=araraPanel}
\setbeamercolor{block title alerted}{fg=araraPaper,bg=araraPrimary}
\setbeamercolor{block body alerted}{fg=araraInk,bg=araraPanelSoft}
\setbeamercolor{block title example}{fg=araraPaper,bg=araraBlue!65!araraPrimary}
\setbeamercolor{block body example}{fg=araraInk,bg=araraPanel}
\else
\definecolor{araraPrimary}{HTML}{174A70}
\definecolor{araraInk}{HTML}{122B3A}
\definecolor{araraGold}{HTML}{D6B875}
\definecolor{araraBlue}{HTML}{4D8297}
\definecolor{araraPaper}{HTML}{F6F7F8}
\definecolor{araraCanvas}{HTML}{F6F7F8}
\definecolor{araraMist}{HTML}{DCE5EA}
\setbeamercolor{normal text}{fg=araraInk,bg=araraCanvas}
\setbeamercolor{structure}{fg=araraPrimary}
\setbeamercolor{alerted text}{fg=araraPrimary}
\setbeamercolor{example text}{fg=araraBlue}
\setbeamercolor{block title}{fg=araraInk,bg=araraGold!45}
\setbeamercolor{block body}{fg=araraInk,bg=araraGold!12}
\setbeamercolor{block title alerted}{fg=araraPaper,bg=araraPrimary}
\setbeamercolor{block body alerted}{fg=araraInk,bg=araraPrimary!8}
\setbeamercolor{block title example}{fg=araraPaper,bg=araraBlue}
\setbeamercolor{block body example}{fg=araraInk,bg=araraBlue!8}
\fi

\setbeamercolor{frametitle}{fg=araraPaper,bg=araraPrimary}
\setbeamercolor{framesubtitle}{fg=araraPaper!78,bg=araraPrimary}
\setbeamercolor{progress bar}{fg=araraGold,bg=araraMist}
\setbeamerfont{title}{size=\huge,series=\bfseries}
\setbeamerfont{frametitle}{size=\large,series=\bfseries}
\setbeamerfont{framesubtitle}{size=\small}
\setbeamerfont{subtitle}{size=\large}
\setbeamertemplate{navigation symbols}{}

\setbeamertemplate{title page}{%
  \begin{tikzpicture}[remember picture,overlay]
    \fill[araraPrimary] (current page.south west) rectangle
    (current page.north east);
    \fill[araraGold] ([xshift=-2.2cm,yshift=1.5cm]current page.east) --
    ([xshift=-4.8cm,yshift=0.5cm]current page.east) --
    ([xshift=-2.4cm,yshift=-0.4cm]current page.east) --
    ([xshift=-0.3cm,yshift=0.5cm]current page.east) -- cycle;
    \fill[araraBlue] ([xshift=-2.2cm,yshift=1.2cm]current page.east)
    circle (0.45cm);
    \fill[araraCanvas] ([xshift=-2.2cm,yshift=1.2cm]current page.east)
    circle (0.2cm);
    \draw[araraPaper!40,line width=0.7pt]
    ([xshift=-5.4cm,yshift=-1.6cm]current page.east) .. controls
    ([xshift=-3.7cm,yshift=-0.7cm]current page.east) and
    ([xshift=-2.8cm,yshift=-2.2cm]current page.east) ..
    ([xshift=-0.5cm,yshift=-1.1cm]current page.east);
    \fill[araraGold] ([xshift=-1.1cm,yshift=-2.2cm]current page.east)
    circle (0.08cm);
    \fill[araraPaper] ([xshift=-4.2cm,yshift=2.1cm]current page.east)
    circle (0.06cm);
  \end{tikzpicture}
  \vspace{0.6cm}
  \begin{minipage}{0.6\textwidth}
    \ifx\insertauthor\@empty\else
    {\usebeamerfont{author}\color{araraGold}\insertauthor\par}
    \vspace{0.5cm}
    \fi
    {\usebeamerfont{title}\color{araraPaper}\inserttitle\par}
    \ifx\insertsubtitle\@empty\else
    \vspace{0.35cm}
    {\usebeamerfont{subtitle}\color{araraPaper!80}\insertsubtitle\par}
    \fi
  \end{minipage}
  \vfill
  \begin{minipage}{0.6\textwidth}
    {\usebeamerfont{institute}\color{araraPaper!65}\insertinstitute\par}
    \ifx\insertdate\@empty\else
    \vspace{0.2cm}
    {\usebeamerfont{date}\color{araraPaper!65}\insertdate\par}
    \fi
  \end{minipage}
  \vspace{0.7cm}
}

\newcommand{\arara@drawprogressbar}{%
  \pgfmathsetmacro{\arara@ratio}{min(1,\insertframenumber/max(1,\inserttotalframenumber))}%
  \pgfmathsetlengthmacro{\arara@progresswidth}{\paperwidth*\arara@ratio}%
  \begin{beamercolorbox}[wd=\paperwidth,ht=1.2pt,dp=0pt]{progress bar}%
    \hbox to \paperwidth{%
      \color{araraGold}\rule{\arara@progresswidth}{1.2pt}%
      \color{araraMist}\rule{\dimexpr\paperwidth-\arara@progresswidth\relax}{1.2pt}%
    }%
  \end{beamercolorbox}%
}

\setbeamertemplate{frametitle}{%
  \begin{beamercolorbox}[wd=\paperwidth,sep=.8em,leftskip=1em]{frametitle}
    \usebeamerfont{frametitle}\insertframetitle\par
    {\usebeamerfont{framesubtitle}\insertframesubtitle\par}
  \end{beamercolorbox}
  \ifx\arara@progressbar\arara@frametitle
  \arara@drawprogressbar
  \fi
}

\setbeamertemplate{footline}{%
  \leavevmode\hbox to \paperwidth{\hfill\usebeamerfont{page number in
  head/foot}\color{araraInk!55}\insertframenumber\hspace{1em}}%
  \ifx\arara@progressbar\arara@foot\arara@drawprogressbar\fi
}

\setbeamertemplate{section page}{%
  \begin{tikzpicture}[remember picture,overlay]
    \fill[araraPrimary] (current page.south west) rectangle
    (current page.north east);
    \fill[araraGold] ([xshift=-1.5cm,yshift=0.8cm]current page.east) --
    ([xshift=-3cm,yshift=0.2cm]current page.east) --
    ([xshift=-1.5cm,yshift=-0.4cm]current page.east) -- cycle;
    \fill[araraBlue] ([xshift=-2.2cm,yshift=0.2cm]current
    page.east) circle (0.14cm);
  \end{tikzpicture}
  \vfill
  {\color{araraGold}\small\bfseries\insertsectionnumber}\par
  \vspace{0.5cm}
  \begin{minipage}{0.7\textwidth}
    {\usebeamerfont{title}\color{araraPaper}\insertsectionhead\par}
  \end{minipage}
  \vfill
}

\def\arara@simple{simple}
\ifx\arara@sectionpage\arara@simple
\AtBeginSection[]{%
  \begin{frame}[plain]
    \sectionpage
  \end{frame}
}
\fi

\mode<all>
